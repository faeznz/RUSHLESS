{
  "version": 2,
  "functions": {
    "RUSHLESS-BE-MOBILE/api/index.js": {
      "runtime": "nodejs18.x",
      "includeFiles": "RUSHLESS-BE-MOBILE/src/views/**"
    }
  },
  "routes": [
    {
      "src": "/(.*)",
      "dest": "RUSHLESS-BE-MOBILE/api/index.js"
    }
  ],
  "env": {
    "MONGODB_URI": "@rushless-be-mobile-mongodb-uri"
  }
}


